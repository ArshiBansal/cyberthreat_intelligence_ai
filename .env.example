# ============================================================
# Threat Incident Intelligence Platform - Local Environment
# ============================================================
# This file is for LOCAL use only. Do NOT commit it to Git.
# Copy from .env.example and replace the placeholder values.
# ============================================================

# ---- MongoDB Connection (required) ----
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB=threat_intelligence

# ---- Collection names ----
MONGODB_COLLECTION_INCIDENTS=incidents
MONGODB_COLLECTION_FEATURES=incident_features
MONGODB_COLLECTION_PREDICTIONS=predictions
MONGODB_COLLECTION_MODELS_METADATA=models_metadata

# ---- Optional: Hugging Face token (uncomment if needed) ----
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional: App settings ----
# STREAMLIT_SERVER_PORT=8501
# LOG_LEVEL=INFO